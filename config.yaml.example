# Copy to config.yaml and customize. config.yaml is gitignored.
# See docs/README.md for full configuration documentation.
#
# Production: set app.debug to false and use a long random app.secret_key.
# Prefer SECRET_KEY environment variable on hosted platforms.

app:
  name: "monAI"
  version: "1.0.0"
  debug: true
  secret_key: "change-me-use-a-long-random-string-in-production"

server:
  allowed_hosts:
    - "localhost"
    - "127.0.0.1"
  timezone: "Asia/Karachi"

# CSRF trusted origins for ngrok tunnels and LAN development (optional).
urls:
  local: "http://127.0.0.1:8000"
  ngrok: ""

database:
  engine: "sqlite3"
  name: "db.sqlite3"

celery:
  broker_url: "redis://localhost:6379/0"
  result_backend: "redis://localhost:6379/0"

# Django cache backend (use DB 1 so Celery broker stays on DB 0)
redis:
  cache_url: "redis://localhost:6379/1"
  cache_timeout_seconds: 3600

# backend: console | smtp
email:
  backend: "console"
  smtp:
    host: "smtp.gmail.com"
    port: 587
    use_tls: true
    user: ""
    password: ""
    default_from: "noreply@example.com"

superuser:
  email: ""
  username: ""
  password: ""

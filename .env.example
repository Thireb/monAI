# Settings for docker-compose.yml. Copy this file to .env and edit it.
# .env holds secrets: git ignores it. Do not commit it.

# A long random string (50 characters or more). Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# The password of the monAI database user. Use a long random string.
DB_PASSWORD=

# The host names of the app, separated by commas. Keep localhost and 127.0.0.1.
# Example: localhost,127.0.0.1,myserver.example.ts.net
ALLOWED_HOSTS=localhost,127.0.0.1

# The full HTTPS addresses of the app, separated by commas.
# Example: https://myserver.example.ts.net
CSRF_TRUSTED_ORIGINS=

# false: try the app over plain HTTP at http://localhost:8000. Login, the PWA and
# Web Push need HTTPS, so set it back to true for real use.
HTTPS_ONLY=true

# false: nobody can make a new account. Make the family accounts first.
ALLOW_SIGNUP=true

# The time zone of the server, for example Asia/Karachi or Europe/London.
TIMEZONE=UTC

# The time of the daily bill alerts, in TIMEZONE.
BILL_ALERT_TIME=09:00

# The address and port of the app on this machine.
MONAI_BIND=127.0.0.1
MONAI_PORT=8000

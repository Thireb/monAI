# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Local network URL (for home network access)
# Find your IP: ip addr | grep "inet " | grep -v 127.0.0.1
LOCAL_SERVER_URL=http://192.168.1.x:8000/minimal/

# Ngrok URL (for external/mobile access)
# Get free URL: ngrok http 8000
NGROK_SERVER_URL=https://your-subdomain.ngrok-free.dev/minimal/

# The app will automatically try Ngrok first, then fall back to Local
